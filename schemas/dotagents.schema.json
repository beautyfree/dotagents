{
  "$ref": "#/definitions/DotagentsPortableConfig",
  "definitions": {
    "DotagentsPortableConfig": {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "number",
          "const": 1
        },
        "minimum_dotagents_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "defaults": {
          "type": "object",
          "properties": {
            "include": {
              "type": "string",
              "enum": [
                "all",
                "owned",
                "selected"
              ],
              "default": "all"
            }
          },
          "additionalProperties": false,
          "default": {
            "include": "all"
          }
        },
        "skills": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "include": {
                "type": "boolean"
              },
              "agents": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
                },
                "minItems": 1
              },
              "distribution": {
                "type": "string",
                "enum": [
                  "dependency",
                  "vendored",
                  "snapshot"
                ]
              },
              "origin": {
                "type": "object",
                "properties": {
                  "url": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2048
                  },
                  "commit": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{40}$"
                  },
                  "skill_path": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2048
                  },
                  "integrity": {
                    "type": "string",
                    "pattern": "^sha256-[A-Za-z0-9+/]+={0,2}$"
                  },
                  "license": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  }
                },
                "required": [
                  "url",
                  "commit",
                  "skill_path",
                  "integrity",
                  "license"
                ],
                "additionalProperties": false
              },
              "snapshot": {
                "type": "object",
                "properties": {
                  "url": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2048
                  },
                  "requested_ref": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  },
                  "skill_path": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2048
                  },
                  "integrity": {
                    "type": "string",
                    "pattern": "^sha256-[A-Za-z0-9+/]+={0,2}$"
                  },
                  "resolved_commit": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{40}$"
                  }
                },
                "required": [
                  "url",
                  "requested_ref",
                  "skill_path",
                  "integrity"
                ],
                "additionalProperties": false
              },
              "forked_from": {
                "type": "object",
                "properties": {
                  "url": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2048
                  },
                  "ref": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  },
                  "skill_path": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2048
                  }
                },
                "required": [
                  "url"
                ],
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          },
          "propertyNames": {
            "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
          },
          "default": {}
        }
      },
      "required": [
        "schema_version"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
