  },
  "bin": {
    "dotagents": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "bun test --timeout 60000",
    "lint": "biome lint src test scripts",
    "format": "biome format --write src test scripts *.json",
    "format:check": "biome format src test scripts *.json",
    "schema:generate": "bun run build && node scripts/generate-schemas.mjs --write",
    "schema:check": "bun run build && node scripts/generate-schemas.mjs --check",
    "api:generate": "bun run build && node scripts/generate-api-snapshot.mjs --write",
    "api:check": "bun run build && node scripts/generate-api-snapshot.mjs --check",
    "check": "bun run lint && bun run format:check && bun run typecheck && bun run test && bun run schema:check && bun run api:check",
    "package:check": "bun run build && node scripts/verify-package.mjs",
    "package:smoke": "bun run build && node scripts/verify-packed-install.mjs",
    "release:artifacts": "node scripts/build-release-artifacts.mjs",
    "release:verify": "node scripts/verify-release-artifacts.mjs",
    "release:publish": "node scripts/publish-release-artifacts.mjs",
    "demo:render": "bun run build && vhs docs/demo/setup.tape",
    "ci": "bun run check && node dist/cli.js inspect fixtures/valid-library --json && node dist/cli.js audit fixtures/valid-library --public --json",
    "release:check": "bun run ci && bun run package:check && bun run package:smoke && bun run api:check"
  },
  "dependencies": {
    "@napi-rs/keyring": "^1.3.0",
    "yaml": "^2.8.3",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@types/bun": "^1.3.12",
    "@types/node": "^24.0.0",
    "typescript": "~5.8.3",
    "zod-to-json-schema": "^3.25.2"
  }
}
