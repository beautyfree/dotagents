    },
    "./repair": {
      "types": "./dist/repair.d.ts",
      "import": "./dist/repair.js"
    },
    "./selection": {
      "types": "./dist/selection.d.ts",
      "import": "./dist/selection.js"
    },
    "./well-known": {
