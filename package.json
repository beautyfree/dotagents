      "import": "./dist/inventory.js"
    },
    "./toolkit-review": {
      "types": "./dist/toolkit-review.d.ts",
      "import": "./dist/toolkit-review.js"
    },
    "./export-policy": {
      "types": "./dist/export-policy.d.ts",
      "import": "./dist/export-policy.js"
    },
    "./init": {
      "types": "./dist/init.d.ts",
      "import": "./dist/init.js"
    },
    "./import": {
      "types": "./dist/import.d.ts",
      "import": "./dist/import.js"
    },
    "./import-apply": {
