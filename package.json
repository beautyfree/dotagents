{
  "name": "dotagents",
  "version": "0.3.0",
  "description": "Carry your AI-agent skills and setup across machines with a portable, Git-backed library",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/beautyfree/dotagents.git"
  },
  "homepage": "https://github.com/beautyfree/dotagents#readme",
  "bugs": {
    "url": "https://github.com/beautyfree/dotagents/issues"
  },
  "type": "module",
  "private": false,
  "keywords": [
    "ai-agents",
    "agent-skills",
    "skills",
    "claude-code",
    "codex",
    "git",
    "dotfiles",
    "ai-productivity",
    "agentic-workflows"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "bun@1.3.14",
  "files": [
    "dist",
    "schemas",
    "docs",
    "api-snapshot.json",
    "CHANGELOG.md",
    "README.md",
    "LICENSE",
    "NOTICE.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "import": "./dist/schema.js"
    },
